@*// Location: frontend/Components/HeroSection.razor
// This component displays the main hero section with headline, subheadline, CTA buttons, and illustration.*@

<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Study Smarter. Not Harder.</h1>
        <p class="hero-subtitle">
            Upload PDFs, generate smart summaries, plan your schedule, and chat with your AI study assistant — all in one place.
        </p>
        <div class="hero-buttons">
            <button class="btn btn-primary cta-btn">Get Started Free</button>
            <button class="btn btn-secondary cta-btn">View Plans</button>
        </div>
    </div>
    <div class="hero-image">
        <img src="images/hero_mockup.png" alt="AI Study Assistant Dashboard Mockup" />
    </div>
</div>
